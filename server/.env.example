# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Configuration
# Replace with your actual MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/locabite?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/locabite

# Authentication / JWT
JWT_SECRET=locabite_super_secure_jwt_access_secret_2026_xyz
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=locabite_super_secure_jwt_refresh_secret_2026_abc
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay Payment Gateway (Test credentials)
RAZORPAY_KEY_ID=rzp_test_locabite_demo
RAZORPAY_KEY_SECRET=rzp_secret_locabite_demo_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_locabite

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=locabite-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_cloudinary_api_secret_key

# Resend Email Configuration (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=LocaBite <onboarding@resend.dev>

# Email SMTP Configuration (Fallback)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="LocaBite Campus" <no-reply@locabite.com>
