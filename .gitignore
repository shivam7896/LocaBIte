# ==========================================
# LocaBite - Root .gitignore
# ==========================================

# 1. Environment & Sensitive Credentials (CRITICAL - DO NOT COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
Frontend/.env
*.pem
*.key
*.cert
# Allow template file
!.env.example
!server/.env.example

# 2. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.pnpm-store/

# 3. Production & Transpiled Build Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/
.vite/
*/.vite/
*.tsbuildinfo

# 4. Logs & Debugging Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Editor & IDE Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# 6. AI & Agent Temporary Metadata
.gemini/
.agents/

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. Temporary & Test Artifacts
tmp/
temp/
*.tmp
server/mongo-memory/
coverage/
.nyc_output/
